# ai module - configure larz-ai, the OS-level model manager + router.
#
# Writes /etc/larzos/ai.toml, which larz-aid reads to know which models to
# keep available locally and which Gateway to fall back to when a request
# needs a model that isn't local (or the box has no GPU).

import "toml" as toml

let id = "ai"
let title = "AI (larz-ai)"

let CONF = "/etc/larzos/ai.toml"

fn plan(spec, ctx) {
  let ai = spec["ai"]
  let want = toml.stringify({
    "gateway": ai["gateway"],
    "local": {"models": ai["local_models"]},
  })
  let have = file_exists(CONF) ? read_file(CONF) : ""
  if have == want {
    return [{"desc": "larz-ai config already current", "cmd": "", "skip": true}]
  }
  let n = str(len(ai["local_models"]))
  return [{
    "desc": "write " + CONF + " (" + n + " local model(s), gateway " + (ai["gateway"] == "" ? "none" : ai["gateway"]) + ")",
    "file": CONF,
    "content": want,
    "skip": false,
  }]
}
