# ai module - configure larz-ai, the OS-level model manager + router.
#
# Manages the `gateway` and `[local] models` keys of /etc/larzos/ai.toml from
# system.lz. Any other keys (default_model, [pricing], ollama ...) that the
# package ships or you edit by hand are left alone.

import "toml" as toml

let id = "ai"
let title = "AI (larz-ai)"

let CONF = "/etc/larzos/ai.toml"

fn _merged(spec) {
  let ai = spec["ai"]
  let c = file_exists(CONF) ? toml.parse(read_file(CONF)) : {}
  c["gateway"] = ai["gateway"]
  if not c.has("local") { c["local"] = {} }
  c["local"]["models"] = ai["local_models"]
  return c
}

fn plan(spec, ctx) {
  let want = toml.stringify(_merged(spec))
  let have = file_exists(CONF) ? read_file(CONF) : ""
  if have == want {
    return [{"desc": "larz-ai config already current", "cmd": "", "skip": true}]
  }
  let ai = spec["ai"]
  return [{
    "desc": "update " + CONF + " (" + str(len(ai["local_models"])) + " local model(s), gateway " +
            (ai["gateway"] == "" ? "none" : ai["gateway"]) + ")",
    "file": CONF,
    "content": want,
    "skip": false,
  }]
}
