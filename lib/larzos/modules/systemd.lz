# systemd module - render systemd units declared in spec.units.
#
# spec.units maps a unit file name to a table of sections:
#
#   "units": {
#     "larz-backup.service": {
#       "Unit":    { "Description": "nightly backup" },
#       "Service": { "Type": "oneshot", "ExecStart": "/usr/bin/larz-backup" },
#     },
#     "larz-backup.timer": {
#       "Timer":   { "OnCalendar": "daily", "Persistent": true },
#       "Install": { "WantedBy": "timers.target" },
#     },
#   }
#
# A value that is a list becomes repeated "key=" lines; a bool becomes
# yes/no. Units are written to /etc/systemd/system; a change triggers
# `systemctl daemon-reload`. Enabling/starting is the services module's job.

let id = "systemd"
let title = "systemd units"

let DIR = "/etc/systemd/system"

fn _val(v) {
  if v == true { return "yes" }
  if v == false { return "no" }
  return str(v)
}

fn render(sections) {
  let out = "# Generated by larz-system (systemd module). Do not edit.\n"
  for sec in keys(sections) {
    out = out + "[" + sec + "]\n"
    let body = sections[sec]
    for k in keys(body) {
      let v = body[k]
      if type(v) == "list" {
        for item in v { out = out + k + "=" + _val(item) + "\n" }
      } else {
        out = out + k + "=" + _val(v) + "\n"
      }
    }
    out = out + "\n"
  }
  return out
}

fn plan(spec, ctx) {
  if not spec.has("units") or len(keys(spec["units"])) == 0 {
    return [{"desc": "no units declared", "cmd": "", "skip": true}]
  }
  let actions = []
  let changed = false
  for name in keys(spec["units"]) {
    let path = DIR + "/" + name
    let want = render(spec["units"][name])
    let have = file_exists(path) ? read_file(path) : ""
    if have == want {
      actions.push({"desc": name + " already current", "cmd": "", "skip": true})
    } else {
      actions.push({"desc": "write unit " + name, "file": path, "content": want, "skip": false})
      changed = true
    }
  }
  if changed {
    actions.push({"desc": "systemctl daemon-reload", "cmd": "systemctl daemon-reload", "skip": false})
  }
  return actions
}
