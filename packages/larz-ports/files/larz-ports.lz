# larz-ports - what is listening on this machine, and what can reach it.
#
# `larz doctor` reports failed units and free disk but says nothing about the
# network surface. ss(8) lists sockets; it does not tell you which of them a
# stranger can actually reach. This reads /proc/net/tcp{,6} directly and gives
# each listener a verdict: EXPOSED (bound to every interface), LOCAL
# (loopback only) or IFACE (one specific address).
#
# Written for LarzOS. No bitwise operators in this language, so the hex in
# /proc is decoded with digit arithmetic.

let HEXD = "0123456789abcdef"

fn hexval(ch) {
  let c = ch.lower()
  let i = 0
  while i < 16 {
    if HEXD[i] == c { return i }
    i = i + 1
  }
  throw "not a hex digit: " + ch
}

fn hex_to_int(h) {
  let n = 0
  let i = 0
  while i < len(h) {
    n = n * 16 + hexval(h[i])
    i = i + 1
  }
  return n
}

# /proc/net/tcp holds the IPv4 address as 8 hex digits in host byte order,
# i.e. the octets are reversed: "0100007F" is 127.0.0.1.
fn hex_to_ipv4(h) {
  let o1 = hex_to_int(h[0] + h[1])
  let o2 = hex_to_int(h[2] + h[3])
  let o3 = hex_to_int(h[4] + h[5])
  let o4 = hex_to_int(h[6] + h[7])
  return str(o4) + "." + str(o3) + "." + str(o2) + "." + str(o1)
}

# IPv6 is 32 hex digits as four little-endian 32-bit words. Only the cases that
# matter for a verdict are named; anything else is shown abbreviated rather
# than wrongly expanded.
fn hex_to_ipv6(h) {
  let allzero = true
  let i = 0
  while i < len(h) {
    if h[i] != "0" { allzero = false }
    i = i + 1
  }
  if allzero { return "::" }
  if h.lower().starts_with("0000000000000000ffff0000") { 
    return "::ffff:" + hex_to_ipv4(h[24] + h[25] + h[26] + h[27] + h[28] + h[29] + h[30] + h[31])
  }
  if h.lower() == "00000000000000000000000001000000" { return "::1" }
  return "[v6]"
}

fn fields(line) {
  let out = []
  for p in line.split(" ") {
    if p != "" { out.push(p) }
  }
  return out
}

fn verdict(ip) {
  if ip == "0.0.0.0" { return "EXPOSED" }
  if ip == "::" { return "EXPOSED" }
  if ip.starts_with("127.") { return "LOCAL" }
  if ip == "::1" { return "LOCAL" }
  return "IFACE"
}

# socket inode -> "pid/command", via one shell call (shell glue only, as the
# language has no readlink builtin).
fn inode_owners() {
  let map = {}
  let out = capture("for p in /proc/[0-9]*; do pid=${p#/proc/}; for f in $p/fd/*; do t=$(readlink $f 2>/dev/null); case $t in socket:*) echo \"${t#socket:[}|$pid\";; esac; done; done 2>/dev/null")
  for line in out.split("\n") {
    if line == "" { continue }
    let bits = line.split("|")
    if len(bits) < 2 { continue }
    let ino = bits[0].replace("]", "")
    if map.has(ino) { continue }
    map[ino] = bits[1]
  }
  return map
}

fn cmd_for_pid(pid) {
  let p = "/proc/" + pid + "/comm"
  let c = capture("cat " + p + " 2>/dev/null")
  return c.strip()
}

fn collect(path, is6, owners) {
  let rows = []
  let raw = ""
  raw = read_file(path)
  let lines = raw.split("\n")
  let i = 1
  while i < len(lines) {
    let f = fields(lines[i])
    i = i + 1
    if len(f) < 10 { continue }
    if f[3] != "0A" { continue }          # 0A = LISTEN
    let la = f[1].split(":")
    if len(la) < 2 { continue }
    let ip = ""
    if is6 { ip = hex_to_ipv6(la[0]) } else { ip = hex_to_ipv4(la[0]) }
    let port = hex_to_int(la[1])
    let ino = f[9]
    let who = "-"
    if owners.has(ino) {
      let pid = owners[ino]
      let nm = cmd_for_pid(pid)
      who = pid + "/" + nm
    }
    rows.push({"ip": ip, "port": port, "proto": "tcp", "who": who,
               "verdict": verdict(ip)})
  }
  return rows
}

# EXPOSED first, then IFACE, then LOCAL; ascending port within each group. A
# human reads this list looking for a surprise, so the surprises go at the top.
fn rank(v) {
  if v == "EXPOSED" { return 0 }
  if v == "IFACE" { return 1 }
  return 2
}

fn sort_rows(rows) {
  # insertion sort: the list is tens of entries, not thousands.
  let out = []
  for r in rows {
    let i = 0
    while i < len(out) {
      let a = rank(r["verdict"])
      let b = rank(out[i]["verdict"])
      if a < b { break }
      if a == b and r["port"] < out[i]["port"] { break }
      i = i + 1
    }
    out.insert(i, r)
  }
  return out
}

fn jesc(s) {
  return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

fn as_json(rows) {
  let out = "[\n"
  let first = true
  for r in rows {
    if not first { out = out + ",\n" }
    first = false
    out = out + "  {\"address\": \"" + jesc(r["ip"]) + "\", \"port\": " + str(r["port"])
        + ", \"proto\": \"" + r["proto"] + "\", \"verdict\": \"" + r["verdict"]
        + "\", \"process\": \"" + jesc(r["who"]) + "\"}"
  }
  return out + "\n]"
}

fn main() {
  let only_exposed = false
  let as_j = false
  for a in args {
    if a == "--exposed" { only_exposed = true }
    if a == "--json" { as_j = true }
    if a == "-h" or a == "--help" {
      print("larz-ports - listening TCP sockets, with an exposure verdict")
      print("")
      print("usage: larz-ports [--exposed] [--json]")
      print("")
      print("  --exposed   show only sockets bound to every interface")
      print("  --json      machine-readable output (for cron checks)")
      print("")
      print("verdicts: EXPOSED = bound to 0.0.0.0 or ::  (reachable off-box)")
      print("          IFACE   = bound to one address")
      print("          LOCAL   = loopback only")
      return 0
    }
  }

  let owners = inode_owners()
  let rows = []
  rows.extend(collect("/proc/net/tcp", false, owners))
  rows.extend(collect("/proc/net/tcp6", true, owners))

  let shown = []
  for r in sort_rows(rows) {
    if only_exposed and r["verdict"] != "EXPOSED" { continue }
    shown.push(r)
  }

  if as_j {
    print(as_json(shown))
    return 0
  }

  print("ADDRESS".ljust(24) + "PORT".rjust(6) + "  " + "VERDICT".ljust(8) + "PROCESS")
  print("".ljust(60, "-"))
  let exposed = 0
  for r in shown {
    if r["verdict"] == "EXPOSED" { exposed = exposed + 1 }
    print(r["ip"].ljust(24) + str(r["port"]).rjust(6) + "  "
          + r["verdict"].ljust(8) + r["who"])
  }
  print("")
  print(str(len(shown)) + " listening socket(s), " + str(exposed) + " reachable off-box")
  return 0
}

main()
