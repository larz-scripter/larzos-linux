# larz-users - Who can log in, and who can become root
#
# The account list is the easy part. Who can actually get IN, and get to root
# once in, is assembled from four places nobody reads together: passwd/shadow,
# sudoers, every authorized_keys, and lastlog. Two findings nothing else gives
# you: a sudo grant for a user who does not exist (create that name and you get
# root), and SSH keys split into restricted-to-a-command versus a bare shell.

import "larzos/pkg" as pkg

pkg.package({
  "name":    "larz-users",
  "version": "0.1.0",
  "summary": "Who can log in, and who can become root",
  "arch":    "all",
  "section": "admin",
  "depends": ["larzscript"],
  "build":   [],
  "install": [
    "install -Dm755 files/larz-users    $DESTDIR/usr/bin/larz-users",
    "install -Dm644 files/larz-users.lz $DESTDIR/usr/lib/larzos/larz-users.lz",
  ],
})
