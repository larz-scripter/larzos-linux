# larz-ai - the OS-level AI model manager and router.
#
# larz-aid is a local HTTP router on 127.0.0.1:8199. Apps POST /route to ask
# the OS which model to use for a task; /chat is proxied to the configured
# Gateway or served by a local model. This makes the AI story an OS service,
# not a per-app concern. Config: /etc/larzos/ai.toml, managed by larz-system.

import "larzos/pkg" as pkg

pkg.package({
  "name":       "larz-ai",
  "version":    "0.1.0",
  "summary":    "OS-level AI model manager and router (local models + Gateway fallback)",
  "arch":       "all",
  "section":    "misc",
  "depends":    ["larzscript", "larz-system", "curl"],
  "conffiles":  ["/etc/larzos/ai.toml"],
  "build":      [],
  "install": [
    "install -Dm755 files/larz-aid.lz  $DESTDIR/usr/lib/larzos/larz-aid.lz",
    "install -Dm755 files/larz-aid     $DESTDIR/usr/bin/larz-aid",
    "install -Dm644 files/larz-ai.service $DESTDIR/lib/systemd/system/larz-ai.service",
    "install -Dm644 files/ai.toml      $DESTDIR/etc/larzos/ai.toml",
  ],
})
