# larz-ai - the OS-level AI model manager and router.
#
# larz-aid is a small daemon that listens on a local socket. Apps ask it
# "give me a model for <task>"; it serves a local model when one fits and
# the box can run it, otherwise it proxies to the configured Gateway. This
# is the piece that makes LarzOS's AI story an OS service, not a per-app
# concern. Config lives at /etc/larzos/ai.toml, managed by larz-system.

import "larzos/pkg" as pkg

pkg.package({
  "name":       "larz-ai",
  "version":    "0.1.0",
  "summary":    "OS-level AI model manager and router (local models + Gateway fallback)",
  "arch":       "all",
  "section":    "misc",
  "depends":    ["larzscript", "curl"],
  "build":      [],
  "install": [
    "install -Dm755 files/larz-aid $DESTDIR/usr/bin/larz-aid",
    "install -Dm644 files/larz-ai.service $DESTDIR/lib/systemd/system/larz-ai.service",
    "install -Dm644 files/ai.toml $DESTDIR/etc/larzos/ai.toml",
  ],
})
