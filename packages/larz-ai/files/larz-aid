#!/usr/bin/env larzscript
# larz-aid - LarzOS AI router. Phase 0 skeleton.
#
#   larz-aid route <task>    print which backend would serve <task>
#   larz-aid models          list configured local models
#   larz-aid serve           (Phase 2) run the local socket daemon
#
# Reads /etc/larzos/ai.toml (managed by `larz-system`):
#
#   gateway = "https://gateway.larzpay.com"
#   [local]
#   models = ["qwen2.5-coder:7b"]

import "toml" as toml

let CONF = env("LARZOS_AI_CONF", "/etc/larzos/ai.toml")

fn load() {
  if not file_exists(CONF) {
    return {"gateway": "", "local": {"models": []}}
  }
  return toml.parse(read_file(CONF))
}

fn local_models(cfg) {
  if not cfg.has("local") { return [] }
  if not cfg["local"].has("models") { return [] }
  return cfg["local"]["models"]
}

# Very small heuristic for the skeleton: coding tasks prefer a local coder
# model if one is configured; everything else goes to the Gateway.
fn route(cfg, task) {
  let models = local_models(cfg)
  if task.contains("code") or task.contains("complete") {
    for m in models {
      if m.contains("coder") or m.contains("code") {
        return {"backend": "local", "model": m}
      }
    }
  }
  if len(models) > 0 and (task.contains("local") or cfg["gateway"] == "") {
    return {"backend": "local", "model": models[0]}
  }
  return {"backend": "gateway", "model": cfg["gateway"]}
}

if len(args) == 0 { print("usage: larz-aid route|models|serve"); exit(0) }
let cmd = args[0]
let cfg = load()

if cmd == "models" {
  let ms = local_models(cfg)
  if len(ms) == 0 { print("(no local models configured)") }
  for m in ms { print("  " + m) }
} else if cmd == "route" {
  if len(args) < 2 { print("larz-aid: route needs a task"); exit(1) }
  let r = route(cfg, args[1])
  print(r["backend"] + "  " + r["model"])
} else if cmd == "serve" {
  print("larz-aid: socket daemon is not implemented yet (Phase 2).")
  print("config ok: gateway=" + cfg["gateway"] + " local=" + str(len(local_models(cfg))) + " model(s)")
} else {
  print("larz-aid: unknown command: " + cmd)
  exit(1)
}
