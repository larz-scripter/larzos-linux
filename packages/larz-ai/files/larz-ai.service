[Unit]
Description=LarzOS AI router (larz-aid)
Documentation=https://larzos.com/larzos-linux/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/larz-aid serve
Restart=on-failure
RestartSec=2
# Phase 0: the daemon is a skeleton and exits immediately. Once the socket
# server lands (Phase 2) this unit supervises it for real.

[Install]
WantedBy=multi-user.target
