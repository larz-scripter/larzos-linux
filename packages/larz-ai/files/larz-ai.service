[Unit]
Description=LarzOS AI router (larz-aid)
Documentation=https://larzos.com/larzos-linux/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/larz-aid serve
Restart=on-failure
RestartSec=2
# Local-only router: binds 127.0.0.1:8199. Apps POST /route to ask the OS
# which model to use; /chat is proxied to the Gateway or served locally.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/larzos

[Install]
WantedBy=multi-user.target
