# larz-secrets - find credentials committed into files on this machine.
#
# The usual way a password gets loose is not a clever attack: someone pastes it
# into a script to get something working, the script ends up in a repo or a
# world-readable directory, and it stays there. This walks a tree, flags lines
# that look like a real credential rather than a placeholder, and reports the
# file mode alongside - because the same password in a 600 file and in a 644
# file are two very different problems.
#
# It never prints a secret. Values are masked to their first and last two
# characters, so the output is safe to paste into a ticket or a log.

# High-confidence prefixes: these are issued tokens with a known shape, so a
# match is a finding and not a guess.
let VENDOR = [
  ["AKIA", "AWS access key id", "critical"],
  ["ASIA", "AWS temporary key id", "high"],
  ["ghp_", "GitHub personal access token", "critical"],
  ["gho_", "GitHub OAuth token", "critical"],
  ["github_pat_", "GitHub fine-grained PAT", "critical"],
  ["sk-ant-", "Anthropic API key", "critical"],
  ["sk-proj-", "OpenAI project key", "critical"],
  ["xoxb-", "Slack bot token", "critical"],
  ["xoxp-", "Slack user token", "critical"],
  ["SG.", "SendGrid API key", "high"],
  ["AIza", "Google API key", "high"],
  ["glpat-", "GitLab personal access token", "critical"],
  ["npm_", "npm access token", "high"],
  ["dop_v1_", "DigitalOcean token", "critical"],
  ["shpat_", "Shopify access token", "high"],
]

# Assignment keys worth inspecting. A hit here is only a finding if the value
# also survives the placeholder test below.
let KEYS = ["password", "passwd", "secret", "api_key", "apikey", "api-key",
            "access_key", "accesskey", "secret_key", "client_secret",
            "auth_token", "authtoken", "private_key", "db_pass", "dbpass",
            "smtp_pass", "token", "passphrase", "credential"]

# Things that look like secrets but are not: templates, env lookups, obvious
# dummies. Without this list the tool cries wolf and gets ignored, which is
# worse than not running it.
#
# The split matters. A value that *is* the word "secret" is a placeholder; a
# value that merely *contains* it - "Sup3rSecretPw99" - is a real password.
# Testing every entry as a substring silently discarded the second kind.
let PH_EXACT = ["password", "passwd", "secret", "token", "null", "none",
                "true", "false", "dummy", "sample", "test123", "changeme",
                "change_me", "unset", "notset", "localhost", "redacted",
                "todo", "fixme", "default", "admin"]

let PH_SUBSTR = ["your_", "yourpassword", "example", "placeholder", "xxxx",
                 "<", ">", "${", "{{", "%s", "$(", "os.environ", "getenv",
                 "process.env", "env[", "env.get", "...", "****",
                 "change_me", "change_this", "replace_me", "replace_with",
                 "to_a_real", "strong_secret", "from_dashboard", "insert_",
                 "paste_", "_here", "random_value", "my_secret", "s3cret",
                 "test_", "_test", "fake", "mock", "demo_", "stub_",
                 "aaaa", "bbbb", "1111", "abcdef0123"]

let SKIP_DIR = [".git/", "node_modules/", "/venv/", "/.venv/",
                "site-packages/", "dist-packages/", "/__pycache__/",
                "/.cache/", "/.npm/", "/.mozilla/", "/proc/", "/sys/",
                "/.terraform/", "/vendor/"]

let SKIP_EXT = [".pyc", ".so", ".o", ".a", ".deb", ".zip", ".gz", ".xz",
                ".bz2", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico",
                ".pdf", ".mp3", ".mp4", ".wav", ".woff", ".woff2", ".ttf",
                ".bin", ".img", ".iso", ".db", ".sqlite", ".lock"]

fn mask(v) {
  if len(v) <= 6 { return "***" }
  return v[0:2] + "***" + v[len(v) - 2:len(v)] + " (" + str(len(v)) + " chars)"
}

let PRINTABLE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'*+,-./:;<=>?@[]^_`{|}~\\\"()"

# A credential is a flat ASCII literal. These three rules removed every false
# positive found on a real repo, and each one has a reason:
#   - whitespace     -> it is a command line, not a value
#                       (/p:PackageCertificatePassword=larzos /m /nologo)
#   - $ or ( or .get -> it is a variable reference or a code expression
#                       ("$AUTH_TOKEN", usage.get("prompt_tokens", 0))
#   - non-ASCII      -> it is binary or prose, and emitting the bytes also
#                       produced invalid UTF-8 in --json output
fn is_code_or_ref(v) {
  if v.contains(" ") or v.contains("\t") { return true }
  if v.contains("$") { return true }
  if v.contains("(") or v.contains(")") { return true }
  if v.contains(".get") or v.contains("->") or v.contains("::") { return true }
  if v.contains("`") { return true }
  return false
}

fn is_ascii_literal(v) {
  if v == "" { return false }
  let i = 0
  while i < len(v) {
    if not PRINTABLE.contains(v[i]) { return false }
    i = i + 1
  }
  return true
}

fn plausible_value(v) {
  if is_code_or_ref(v) { return false }
  if not is_ascii_literal(v) { return false }
  return true
}

fn has_long_run(v) {
  let run = 1
  let i = 1
  while i < len(v) {
    if v[i] == v[i - 1] {
      run = run + 1
      if run >= 6 { return true }
    } else { run = 1 }
    i = i + 1
  }
  return false
}

fn is_placeholder(v) {
  # "-" and "_" are interchangeable in every placeholder convention, so the
  # separator is normalised rather than enumerated.
  let low = v.lower().replace("-", "_")
  if len(low) < 8 { return true }
  for p in PH_EXACT {
    if low == p { return true }
  }
  for p in PH_SUBSTR {
    if low.contains(p) { return true }
  }
  if has_long_run(low) { return true }
  return false
}

# A real credential mixes character classes. A long lowercase English word does
# not, and neither does a file path - both are common false positives.
fn looks_random(v) {
  let digits = 0
  let upper = 0
  let lower = 0
  let other = 0
  let i = 0
  while i < len(v) {
    let c = v[i]
    if "0123456789".contains(c) { digits = digits + 1 }
    else {
      if c == c.upper() and c != c.lower() { upper = upper + 1 }
      else {
        if "abcdefghijklmnopqrstuvwxyz".contains(c) { lower = lower + 1 }
        else {
          if c != "-" and c != "_" { other = other + 1 }
        }
      }
    }
    i = i + 1
  }
  let classes = 0
  if digits > 0 { classes = classes + 1 }
  if upper > 0 { classes = classes + 1 }
  if lower > 0 { classes = classes + 1 }
  if other > 0 { classes = classes + 1 }
  # a pure-hex string of 32+ is a credential shape even with one class
  if classes == 1 and digits + lower >= 32 { return true }
  return classes >= 2
}

fn strip_quotes(v) {
  let s = v.strip()
  # strip trailing syntax a value commonly carries
  while len(s) > 0 and (s.ends_with(",") or s.ends_with(";") or s.ends_with(")")
                        or s.ends_with("}")) {
    s = s[0:len(s) - 1]
  }
  s = s.strip()
  if len(s) >= 2 {
    if s.starts_with("\"") and s.ends_with("\"") { return s[1:len(s) - 1] }
    if s.starts_with("'") and s.ends_with("'") { return s[1:len(s) - 1] }
  }
  return s
}

let CODE_EXT = [".py", ".js", ".ts", ".jsx", ".tsx", ".lz", ".go", ".rb",
                ".php", ".java", ".c", ".h", ".cpp", ".rs", ".cs", ".kt",
                ".swift", ".pl", ".lua", ".scala", ".m"]

fn is_code_file(path) {
  let low = path.lower()
  for e in CODE_EXT {
    if low.ends_with(e) { return true }
  }
  # a backup copy of a source file is still source
  for e in CODE_EXT {
    if low.contains(e + ".bak") { return true }
  }
  return false
}

fn quoted(v) {
  let t = v.strip()
  return t.starts_with("\"") or t.starts_with("'")
}

# the value before quote-stripping, so the caller can tell a literal from an
# identifier
fn raw_after(line, sep) {
  if not line.contains(sep) { return "" }
  let parts = line.split(sep)
  if len(parts) < 2 { return "" }
  let rest = ""
  let i = 1
  while i < len(parts) {
    if rest != "" { rest = rest + sep }
    rest = rest + parts[i]
    i = i + 1
  }
  return rest.strip()
}

fn value_after(line, sep) {
  if not line.contains(sep) { return "" }
  let parts = line.split(sep)
  if len(parts) < 2 { return "" }
  # rejoin the remainder: a value may itself contain the separator
  let rest = ""
  let i = 1
  while i < len(parts) {
    if rest != "" { rest = rest + sep }
    rest = rest + parts[i]
    i = i + 1
  }
  # a trailing comment is not part of the value
  let v = rest
  if v.contains(" #") { v = v.split(" #")[0] }
  return strip_quotes(v)
}

# ---------------------------------------------------------------- scanning

fn scan_line(line, codefile) {
  # returns [] or [kind, severity, masked]
  let t = line.strip()
  if t == "" { return [] }
  if len(t) > 500 { return [] }

  if t.contains("PRIVATE KEY-----") and t.contains("-----BEGIN") {
    return ["private key block", "critical", "(key material)"]
  }

  for v in VENDOR {
    if t.contains(v[0]) {
      # pull the token itself out so it can be masked and length-checked
      let after = t.split(v[0])[1]
      let tok = ""
      let i = 0
      while i < len(after) {
        let c = after[i]
        if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-".contains(c) {
          tok = tok + c
        } else { break }
        i = i + 1
      }
      if len(tok) >= 10 { return [v[1], v[2], mask(v[0] + tok)] }
    }
  }

  # a connection string carrying an inline password
  for sch in ["postgres://", "postgresql://", "mysql://", "mongodb://",
              "redis://", "amqp://", "ftp://"] {
    if t.lower().contains(sch) {
      let tail = t.lower().split(sch)[1]
      if tail.contains("@") and tail.split("@")[0].contains(":") {
        let cred = tail.split("@")[0]
        let pw = cred.split(":")[1]
        if plausible_value(pw) and not is_placeholder(pw) {
          return ["password in " + sch + " URL", "critical", mask(pw)]
        }
      }
    }
  }

  let low = t.lower()
  # "!=" / "==" / ">=" / "<=" mean this line compares a secret, it does not
  # define one. Splitting on "=" here invents a value out of the right-hand
  # side of a conditional.
  for cmp in ["!=", "==", ">=", "<=", "=>", "=~"] {
    if low.contains(cmp) { return [] }
  }
  for k in KEYS {
    if not low.contains(k) { continue }
    # the key must be on the left of an assignment, not buried in prose
    let idx_ok = false
    for sep in ["=", ":"] {
      if not low.contains(sep) { continue }
      let lhs = low.split(sep)[0]
      if lhs.contains(k) and len(lhs) < 60 { idx_ok = true }
    }
    if not idx_ok { continue }

    let val = ""
    let raw = ""
    if low.contains("=") { val = value_after(t, "=") raw = raw_after(t, "=") }
    if val == "" and low.contains(":") { val = value_after(t, ":") raw = raw_after(t, ":") }
    if val == "" { continue }
    if codefile and not quoted(raw) { continue }
    if not plausible_value(val) { continue }
    if is_placeholder(val) { continue }
    if not looks_random(val) { continue }
    if val.starts_with("/") or val.starts_with("./") { continue }
    let sev = "medium"
    if len(val) >= 20 { sev = "high" }
    return ["hardcoded " + k, sev, mask(val)]
  }
  return []
}

fn mode_of(path) {
  let m = capture("stat -c %a '" + path + "' 2>/dev/null").strip()
  if m == "" { return "?" }
  return m
}

fn world_readable(mode) {
  if len(mode) < 3 { return false }
  let last = mode[len(mode) - 1]
  return "4567".contains(last)
}

fn skippable(path) {
  for d in SKIP_DIR {
    if path.contains(d) { return true }
  }
  for e in SKIP_EXT {
    if path.lower().ends_with(e) { return true }
  }
  return false
}

fn jesc(s) {
  return s.replace("\\", "\\\\").replace("\"", "\\\"")
}

fn as_json(hits) {
  let out = "[\n"
  let first = true
  for h in hits {
    if not first { out = out + ",\n" }
    first = false
    out = out + "  {\"file\": \"" + jesc(h["file"]) + "\", \"line\": " + str(h["line"])
        + ", \"kind\": \"" + jesc(h["kind"]) + "\", \"severity\": \"" + h["sev"]
        + "\", \"value\": \"" + jesc(h["masked"]) + "\", \"mode\": \"" + h["mode"]
        + "\", \"world_readable\": " + str(h["wr"]).lower() + "}"
  }
  return out + "\n]"
}

fn sev_rank(s) {
  if s == "critical" { return 0 }
  if s == "high" { return 1 }
  if s == "medium" { return 2 }
  return 3
}

fn main() {
  let root = ""
  let as_j = false
  let i = 0
  while i < len(args) {
    let a = args[i]
    if a == "--json" { as_j = true }
    else {
      if a == "-h" or a == "--help" {
        print("larz-secrets - find credentials committed into files")
        print("")
        print("usage: larz-secrets [PATH] [--json]")
        print("")
        print("  PATH    directory to scan (default: the current directory)")
        print("  --json  machine-readable output")
        print("")
        print("Values are always masked, so the output is safe to share.")
        print("A finding in a world-readable file is reported as WORLD-READABLE:")
        print("that is the one to fix first.")
        return 0
      }
      if not a.starts_with("-") and root == "" { root = a }
    }
    i = i + 1
  }
  if root == "" { root = cwd() }

  # one find call enumerates candidates; reading and judging is done here. Files
  # over 256k are skipped - credentials live in config, not in blobs.
  let listing = capture("find '" + root + "' -type f -size -256k 2>/dev/null | head -20000")
  let hits = []
  let scanned = 0
  for path in listing.split("\n") {
    if path == "" { continue }
    if skippable(path) { continue }
    let body = ""
    body = read_file(path)
    if body == "" { continue }
    # a NUL byte means binary; skip rather than emit garbage
    if body.contains("\u0000") { continue }
    scanned = scanned + 1
    let n = 0
    for line in body.split("\n") {
      n = n + 1
      let r = scan_line(line, is_code_file(path))
      if len(r) == 3 {
        let md = mode_of(path)
        hits.push({"file": path, "line": n, "kind": r[0], "sev": r[1],
                   "masked": r[2], "mode": md, "wr": world_readable(md)})
      }
    }
  }

  # critical first, and a world-readable finding outranks a private one of the
  # same severity - that is the ordering a person actually needs.
  let sorted_hits = []
  for h in hits {
    let j = 0
    while j < len(sorted_hits) {
      let a = sev_rank(h["sev"])
      let b = sev_rank(sorted_hits[j]["sev"])
      if a < b { break }
      if a == b and h["wr"] and not sorted_hits[j]["wr"] { break }
      j = j + 1
    }
    sorted_hits.insert(j, h)
  }

  if as_j {
    print(as_json(sorted_hits))
    return 0
  }

  if len(sorted_hits) == 0 {
    print("No credentials found in " + str(scanned) + " text file(s) under " + root + ".")
    return 0
  }

  let crit = 0
  let wr = 0
  for h in sorted_hits {
    if h["sev"] == "critical" { crit = crit + 1 }
    if h["wr"] { wr = wr + 1 }
  }

  print("SEVERITY  MODE  WHAT")
  print("".ljust(74, "-"))
  for h in sorted_hits {
    let flag = ""
    if h["wr"] { flag = "  WORLD-READABLE" }
    print(h["sev"].ljust(10) + h["mode"].ljust(6) + h["kind"] + flag)
    print("".ljust(16) + h["file"] + ":" + str(h["line"]))
    print("".ljust(16) + h["masked"])
    print("")
  }
  print(str(len(sorted_hits)) + " finding(s) in " + str(scanned) + " file(s): "
        + str(crit) + " critical, " + str(wr) + " in world-readable files")
  return 0
}

main()
