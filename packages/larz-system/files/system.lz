# /etc/larzos/system.lz - this machine, described in Larzscript.
#
#   larz-system plan          preview the changes
#   sudo larz-system apply    converge the machine
#
# This default is intentionally conservative. Uncomment and edit as needed;
# see https://larzos.com/larzos-linux/ and `larz-system modules`.

import "larzos" as larzos

larzos.system({
  "hostname": "larzos",

  # "users": [
  #   { "name": "larz", "groups": ["sudo"], "shell": "/usr/bin/larzsh" },
  # ],

  "packages": ["larz-system", "larz-ai", "larz-claude-code"],

  "services": {
    "larz-ai": "enabled",
  },

  # "audio": { "profile": "pro", "quantum": 128, "rate": 48000 },

  "ai": {
    "local_models": [],
    "gateway": "https://gateway.larzos.com",
  },

  # Add "larz-gui" to packages[] above, then uncomment to get a branded
  # Openbox/tint2 desktop over VNC (most LarzOS targets have no native
  # display). Run `vncpasswd` once before starting it with `larz-gui start`.
  # "gui": { "enabled": true, "display": 1, "resolution": "1366x800" },
})
