// LarzOS plymouth splash - centered logo, cyan on near-black. Minimal on purpose.

Window.SetBackgroundTopColor(0.043, 0.063, 0.125);      // #0b1020
Window.SetBackgroundBottomColor(0.020, 0.030, 0.060);

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

status = "";
fun draw_status () {
    s.image  = Image.Text(status, 0.60, 0.70, 0.75);
    s.sprite = Sprite(s.image);
    s.sprite.SetX(Window.GetWidth() / 2 - s.image.GetWidth() / 2);
    s.sprite.SetY(logo.sprite.GetY() + logo.image.GetHeight() + 28);
}

fun on_message (text) { status = text; draw_status(); }
Plymouth.SetMessageFunction(on_message);

fun on_password (prompt, bullets) {
    p.image  = Image.Text(prompt + "  " + bullets, 0.85, 0.92, 0.97);
    p.sprite = Sprite(p.image);
    p.sprite.SetX(Window.GetWidth() / 2 - p.image.GetWidth() / 2);
    p.sprite.SetY(logo.sprite.GetY() + logo.image.GetHeight() + 28);
}
Plymouth.SetDisplayPasswordFunction(on_password);
