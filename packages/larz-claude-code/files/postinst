#!/bin/sh
set -e
case "$1" in
  configure)
    if command -v claude >/dev/null 2>&1; then
      echo "larz-claude-code: Claude Code already present ($(claude --version 2>/dev/null || echo installed))"
    elif command -v npm >/dev/null 2>&1; then
      echo "larz-claude-code: installing @anthropic-ai/claude-code (npm, global)..."
      if npm install -g --no-fund --no-audit @anthropic-ai/claude-code; then
        echo "larz-claude-code: done. Run 'larz code' to start (first run signs you in)."
      else
        echo "larz-claude-code: npm install did not complete (offline?)."
        echo "  Retry later:  sudo npm install -g @anthropic-ai/claude-code"
        echo "  Or just run 'larz code' - it will retry the install."
      fi
    else
      echo "larz-claude-code: npm not found. Install nodejs + npm, then run 'larz code'."
    fi
    ;;
esac
exit 0
