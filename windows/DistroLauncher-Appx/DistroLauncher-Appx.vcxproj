  <!--
    This project has no C++ sources. LarzOS.exe (built by the `LarzOS` project)
    is the app payload and must land in this project's $(OutDir) as
    $(TargetName).exe before packaging. In Visual Studio the solution
    dependency builds LarzOS first and this step copies it across; the CI build
    also drops it into $(OutDir) directly, so the copy is a no-op there.
  -->
  <ItemGroup>
    <CustomBuild Include="stage-launcher.txt">
      <FileType>Document</FileType>
      <ExcludedFromBuild>false</ExcludedFromBuild>
      <Message>Stage LarzOS.exe into the MSIX payload ($(OutDir))</Message>
      <AdditionalInputs>$(SolutionDir)$(Platform)\$(Configuration)\LarzOS.exe;%(AdditionalInputs)</AdditionalInputs>
      <Command>if not exist "$(OutDir)" md "$(OutDir)"
if exist "$(SolutionDir)$(Platform)\$(Configuration)\LarzOS.exe" copy /Y "$(SolutionDir)$(Platform)\$(Configuration)\LarzOS.exe" "$(OutDir)$(TargetName).exe"
if not exist "$(OutDir)$(TargetName).exe" exit /b 1
exit /b 0</Command>
      <Outputs>$(OutDir)$(TargetName).exe;%(Outputs)</Outputs>
    </CustomBuild>
  </ItemGroup>
